        "category": "BC ALM"
      },
      {
        "command": "bcAlm.newCustomization",
        "title": "New Agent / Skill / Prompt / Instruction…",
        "category": "BC ALM",
        "icon": "$(add)"
      },
      {
        "command": "bcAlm.saveToTemplate",
        "title": "Save to My Template…",
        "category": "BC ALM",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "bcAlm.contributeUpstream",
        "title": "Contribute to Source Template (Pull Request)…",
        "category": "BC ALM",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "bcAlm.createTemplateRepo",
        "title": "Copy a Template into My Own Repository…",
        "category": "BC ALM",
        "icon": "$(repo-forked)"
      },
      {
        "command": "bcAlm.addTemplateSource",
        "title": "Add Template Source…",
        "category": "BC ALM",
        "icon": "$(plug)"
      },
      {
