        "category": "BC ALM",
        "icon": "$(star)"
      },
      {
        "command": "bcAlm.syncTemplateFromUpstream",
        "title": "Pull Upstream Updates into My Template (fork sync)",
        "category": "BC ALM",
        "icon": "$(repo-sync)"
      },
      {
        "command": "bcAlm.disableTemplate",
        "title": "Disable Template",
        "category": "BC ALM",
        "icon": "$(circle-slash)"
      },
      {
        "command": "bcAlm.enableTemplate",
        "title": "Enable Template",
        "category": "BC ALM",
        "icon": "$(check)"
      },
      {
        "command": "bcAlm.activateOnlyTemplate",
        "title": "Activate Only This Template",
        "category": "BC ALM",
        "icon": "$(target)"
      },
      {
        "command": "bcAlm.switchTemplates",
        "title": "Switch Active Templates…",
        "category": "BC ALM",
