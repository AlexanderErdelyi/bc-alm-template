      {
        "command": "bcAlm.upgradeSourceVersion",
        "title": "Upgrade to Newest Version",
        "category": "BC ALM",
        "icon": "$(arrow-circle-up)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bcAlm.updateComponent",
          "when": "false"
        },
        {
          "command": "bcAlm.mergeComponent",
          "when": "false"
        },
        {
          "command": "bcAlm.resetComponent",
          "when": "false"
        },
        {
          "command": "bcAlm.skipUpdate",
          "when": "false"
        },
        {
          "command": "bcAlm.keepLocal",
          "when": "false"
        },
        {
          "command": "bcAlm.unkeepLocal",
          "when": "false"
        },
        {
          "command": "bcAlm.disableComponent",
          "when": "false"
        },
        {
          "command": "bcAlm.enableComponent",
          "when": "false"
        },
        {
          "command": "bcAlm.installComponent",
          "when": "false"
        },
        {
          "command": "bcAlm.switchSource",
          "when": "false"
        },
        {
          "command": "bcAlm.removeTemplateSource",
          "when": "false"
        },
        {
          "command": "bcAlm.useSourceInProject",
          "when": "false"
        },
        {
          "command": "bcAlm.setPrimarySource",
          "when": "false"
        },
        {
          "command": "bcAlm.syncTemplateFromUpstream",
          "when": "false"
        },
        {
          "command": "bcAlm.openUrl",
          "when": "false"
        },
        {
          "command": "bcAlm.openFile",
          "when": "false"
        },
        {
          "command": "bcAlm.openFinding",
          "when": "false"
        },
        {
          "command": "bcAlm.adoptBaseline",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.migrateLayout",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.manageComponents",
          "when": "false"
        },
        {
          "command": "bcAlm.changeSourceRef",
          "when": "false"
        },
        {
          "command": "bcAlm.openSourceOnGitHub",
          "when": "false"
        },
        {
          "command": "bcAlm.disableTemplate",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.enableTemplate",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.activateOnlyTemplate",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.switchTemplates",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.addProjectSourcesToSettings",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.groupByTemplate",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.groupByKind",
          "when": "bcAlm.hasProject"
        },
        {
          "command": "bcAlm.compareWithBase",
          "when": "false"
        },
        {
          "command": "bcAlm.upgradeSourceVersion",
          "when": "false"
        },
        {
          "command": "bcAlm.releaseTemplateVersion",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "bcAlm.refresh",
          "when": "view == bcAlm.components",
          "group": "navigation@1"
        },
        {
          "command": "bcAlm.updateAll",
          "when": "view == bcAlm.components && bcAlm.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "bcAlm.newCustomization",
          "when": "view == bcAlm.components && bcAlm.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "bcAlm.validate",
          "when": "view == bcAlm.components && bcAlm.hasProject",
          "group": "navigation@4"
        },
        {
          "command": "bcAlm.newProject",
          "when": "view == bcAlm.components",
          "group": "1_project@1"
        },
        {
          "command": "bcAlm.addToExistingRepo",
          "when": "view == bcAlm.components",
          "group": "1_project@2"
        },
        {
          "command": "bcAlm.reapplyValues",
          "when": "view == bcAlm.components && bcAlm.hasProject",
          "group": "1_project@3"
        },
        {
          "command": "bcAlm.groupByTemplate",
          "when": "view == bcAlm.components && bcAlm.hasProject && bcAlm.groupMode == kind",
          "group": "navigation@5"
        },
        {
          "command": "bcAlm.groupByKind",
          "when": "view == bcAlm.components && bcAlm.hasProject && bcAlm.groupMode == template",
          "group": "navigation@5"
        },
        {
          "command": "bcAlm.switchTemplates",
          "when": "view == bcAlm.components && bcAlm.hasProject",
          "group": "2_templates@1"
        },
        {
          "command": "bcAlm.createNewTemplate",
          "when": "view == bcAlm.components",
          "group": "2_templates@2"
        },
        {
          "command": "bcAlm.addTemplateSource",
          "when": "view == bcAlm.sources",
          "group": "navigation@1"
        },
        {
          "command": "bcAlm.createNewTemplate",
          "when": "view == bcAlm.sources",
          "group": "navigation@2"
        },
        {
          "command": "bcAlm.browseTemplates",
          "when": "view == bcAlm.sources",
          "group": "navigation@3"
        },
        {
          "command": "bcAlm.createTemplateRepo",
          "when": "view == bcAlm.sources",
          "group": "1_create@1"
        },
        {
          "command": "bcAlm.shareTemplateSources",
          "when": "view == bcAlm.sources",
          "group": "2_team@1"
        },
        {
          "command": "bcAlm.addProjectSourcesToSettings",
          "when": "view == bcAlm.sources && bcAlm.hasProject",
          "group": "2_team@2"
        },
        {
          "command": "bcAlm.refreshGuidance",
          "when": "view == bcAlm.guidance",
          "group": "navigation@1"
        },
        {
          "command": "bcAlm.openBestPractices",
          "when": "view == bcAlm.guidance",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bcAlm.updateComponent",
          "when": "viewItem =~ /^component:(update|new|removed)/",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.mergeComponent",
          "when": "viewItem =~ /^component:conflict/",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.installComponent",
          "when": "viewItem =~ /^component:(available|missing)/ && !(viewItem =~ /templateOff/)",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.enableComponent",
          "when": "viewItem =~ /^component:disabled/ && !(viewItem =~ /templateOff/)",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.showDiff",
          "when": "viewItem =~ /^(component|file):(update|conflict|modified|missing)/",
          "group": "inline@2"
        },
        {
          "command": "bcAlm.updateComponent",
          "when": "viewItem =~ /^component:(update|new|removed)/",
          "group": "1_sync@1"
        },
        {
          "command": "bcAlm.mergeComponent",
          "when": "viewItem =~ /^component:conflict/",
          "group": "1_sync@2"
        },
        {
          "command": "bcAlm.skipUpdate",
          "when": "viewItem =~ /^component:(update|conflict)/",
          "group": "1_sync@3"
        },
        {
          "command": "bcAlm.resetComponent",
          "when": "viewItem =~ /^component:(conflict|modified)/",
          "group": "1_sync@4"
        },
        {
          "command": "bcAlm.showDiff",
          "when": "viewItem =~ /^(component|file):(update|conflict|modified|missing)/",
          "group": "1_sync@5"
        },
        {
          "command": "bcAlm.installComponent",
          "when": "viewItem =~ /^component:(available|missing)/ && !(viewItem =~ /templateOff/)",
          "group": "1_sync@6"
        },
        {
          "command": "bcAlm.keepLocal",
          "when": "viewItem =~ /^component:(current|update|conflict|modified)/ && !(viewItem =~ /keepLocal/)",
          "group": "2_policy@1"
        },
        {
          "command": "bcAlm.unkeepLocal",
          "when": "viewItem =~ /keepLocal/",
          "group": "2_policy@1"
        },
        {
          "command": "bcAlm.disableComponent",
          "when": "viewItem =~ /^component:(current|update|conflict|modified|missing|custom|removed)/",
          "group": "2_policy@2"
        },
        {
          "command": "bcAlm.enableComponent",
          "when": "viewItem =~ /^component:disabled/ && !(viewItem =~ /templateOff/)",
          "group": "2_policy@2"
        },
        {
          "command": "bcAlm.switchSource",
          "when": "viewItem =~ /^component:(current|update|conflict|modified|available)/",
          "group": "2_policy@3"
        },
        {
          "command": "bcAlm.saveToTemplate",
          "when": "viewItem =~ /^component:(current|update|conflict|modified|custom|removed)/",
          "group": "3_publish@1"
        },
        {
          "command": "bcAlm.contributeUpstream",
          "when": "viewItem =~ /^component:(current|update|conflict|modified|custom|removed)/",
          "group": "3_publish@2"
        },
        {
          "command": "bcAlm.reviewWithCopilot",
          "when": "viewItem =~ /^component:(current|update|conflict|modified|custom|removed)/",
          "group": "4_guidance@1"
        },
        {
          "command": "bcAlm.enableTemplate",
          "when": "viewItem =~ /^component:.*templateOff/",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.enableTemplate",
          "when": "viewItem =~ /^component:.*templateOff/",
          "group": "2_policy@4"
        },
        {
          "command": "bcAlm.manageComponents",
          "when": "viewItem =~ /^template:enabled.*hasSource/",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.enableTemplate",
          "when": "viewItem =~ /^template:disabled/",
          "group": "inline@2"
        },
        {
          "command": "bcAlm.manageComponents",
          "when": "viewItem =~ /^template:enabled.*hasSource/",
          "group": "1_template@1"
        },
        {
          "command": "bcAlm.disableTemplate",
          "when": "viewItem =~ /^template:enabled/",
          "group": "1_template@2"
        },
        {
          "command": "bcAlm.enableTemplate",
          "when": "viewItem =~ /^template:disabled/",
          "group": "1_template@2"
        },
        {
          "command": "bcAlm.activateOnlyTemplate",
          "when": "viewItem =~ /^template:/ && bcAlm.multiTemplate",
          "group": "1_template@3"
        },
        {
          "command": "bcAlm.manageComponents",
          "when": "viewItem =~ /^source:.*inProject/ && viewItem =~ /tplEnabled/",
          "group": "inline@2"
        },
        {
          "command": "bcAlm.manageComponents",
          "when": "viewItem =~ /^source:.*inProject/",
          "group": "0_project@1"
        },
        {
          "command": "bcAlm.disableTemplate",
          "when": "viewItem =~ /^source:.*tplEnabled/",
          "group": "0_project@2"
        },
        {
          "command": "bcAlm.enableTemplate",
          "when": "viewItem =~ /^source:.*tplDisabled/",
          "group": "0_project@2"
        },
        {
          "command": "bcAlm.activateOnlyTemplate",
          "when": "viewItem =~ /^source:.*inProject/ && bcAlm.multiTemplate",
          "group": "0_project@3"
        },
        {
          "command": "bcAlm.useSourceInProject",
          "when": "viewItem =~ /^source:/ && !(viewItem =~ /inProject/) && bcAlm.hasProject",
          "group": "0_project@4"
        },
        {
          "command": "bcAlm.setPrimarySource",
          "when": "viewItem =~ /inProject/ && !(viewItem =~ /primary/)",
          "group": "0_project@5"
        },
        {
          "command": "bcAlm.changeSourceRef",
          "when": "viewItem =~ /^source:/",
          "group": "1_source@2"
        },
        {
          "command": "bcAlm.openSourceOnGitHub",
          "when": "viewItem =~ /^source:/",
          "group": "1_source@3"
        },
        {
          "command": "bcAlm.useSourceInProject",
          "when": "viewItem =~ /^source:/ && !(viewItem =~ /inProject/) && bcAlm.hasProject",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.setPrimarySource",
          "when": "viewItem =~ /inProject/ && !(viewItem =~ /primary/)",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.syncTemplateFromUpstream",
          "when": "viewItem =~ /^source:/ && !(viewItem =~ /upstreamDefault/)",
          "group": "1_source@1"
        },
        {
          "command": "bcAlm.removeTemplateSource",
          "when": "viewItem =~ /^source:/ && !(viewItem =~ /upstreamDefault/)",
          "group": "1_source@9"
        },
        {
          "command": "bcAlm.browseTemplates",
          "when": "view == bcAlm.sources && viewItem =~ /^repo/",
          "group": "inline@1"
        },
        {
          "command": "bcAlm.createCatalogTemplate",
          "when": "view == bcAlm.sources && viewItem =~ /^repo/",
          "group": "inline@2"
        },
        {
          "command": "bcAlm.browseTemplates",
          "when": "view == bcAlm.sources && viewItem =~ /^repo/",
          "group": "1_repo@1"
        },
        {
          "command": "bcAlm.createCatalogTemplate",
          "when": "view == bcAlm.sources && viewItem =~ /^repo/",
          "group": "1_repo@2"
        },
        {
          "command": "bcAlm.createVariant",
          "when": "view == bcAlm.sources && viewItem =~ /^repo/",
          "group": "1_repo@3"
        },
        {
          "command": "bcAlm.upgradeSourceVersion",
          "when": "viewItem =~ /^source:.*upgrade/",
          "group": "inline@0"
        },
        {
          "command": "bcAlm.upgradeSourceVersion",
          "when": "viewItem =~ /^source:.*upgrade/",
          "group": "1_source@0"
        },
        {
          "command": "bcAlm.browseTemplates",
          "when": "viewItem =~ /^source:/",
          "group": "2_author@1"
        },
        {
          "command": "bcAlm.createVariant",
          "when": "viewItem =~ /^source:/",
          "group": "2_author@2"
        },
        {
          "command": "bcAlm.releaseTemplateVersion",
          "when": "viewItem =~ /^source:/",
          "group": "2_author@3"
        },
        {
          "command": "bcAlm.compareWithBase",
          "when": "viewItem =~ /^component:.*override/",
          "group": "3_publish@3"
        },
        {
          "command": "bcAlm.compareWithBase",
          "when": "viewItem =~ /^component:.*override/",
          "group": "inline@5"
        }
      ],
      "editor/title": [
        {
          "command": "bcAlm.reviewWithCopilot",
          "when": "resourceFilename =~ /\\.(agent|prompt|instructions)\\.md$|^SKILL\\.md$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "bcAlm.saveToTemplate",
          "when": "resourceFilename =~ /\\.(agent|prompt|instructions)\\.md$|^SKILL\\.md$/",
          "group": "bcAlm@1"
        },
        {
          "command": "bcAlm.contributeUpstream",
          "when": "resourceFilename =~ /\\.(agent|prompt|instructions)\\.md$|^SKILL\\.md$/",
          "group": "bcAlm@2"
        },
        {
          "command": "bcAlm.reviewWithCopilot",
          "when": "resourceFilename =~ /\\.(agent|prompt|instructions)\\.md$|^SKILL\\.md$/",
          "group": "bcAlm@3"
        }
      ]
    },
    "configuration": {
      "title": "BC ALM",
      "properties": {
        "bcAlm.templateSources": {
          "type": "array",
          "markdownDescription": "Template repositories you can create projects from and pull agents/skills/prompts/instructions from. The first entry is the default for new projects. A catalog repository holds several templates (root + `.templates/<id>/`); add one entry per template with `path`, or use **Add Template Source…** / **Browse Templates…**.",
          "default": [
            {
              "name": "BC ALM Template (upstream)",
              "url": "https://github.com/AlexanderErdelyi/bc-alm-template.git",
              "ref": "main"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name."
              },
              "url": {
                "type": "string",
                "description": "Git URL (https or ssh) or local path of the template repository."
              },
              "path": {
                "type": "string",
                "description": "Folder of the template inside a catalog repository, e.g. .templates/bc-upgrade (empty = the root template)."
              },
              "ref": {
                "type": "string",
                "default": "main",
                "description": "Branch, tag (e.g. bc-upgrade/v1.2.0) or \"latest\" (newest released version of the template)."
              },
              "upstream": {
                "type": "string",
                "description": "Git URL of the template this one was created from. \"Sync from Upstream\" merges its changes in."
              }
            }
          }
        },
        "bcAlm.components.groupBy": {
          "type": "string",
          "enum": [
            "auto",
            "template",
            "kind"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Group by template when the project uses more than one, otherwise by kind.",
            "Always group by template (BC ALM, BC Upgrade, Local only).",
            "Always group by kind (Agents, Skills, Prompts, …)."
          ],
          "markdownDescription": "How the **Components** view is grouped."
        },
        "bcAlm.checkForUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Fetch template sources and compute component status when a BC ALM project opens."
        },
        "bcAlm.fetchIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Minimum minutes between automatic fetches of a template source (0 = always fetch on refresh). The refresh button always fetches."
        },
        "bcAlm.powershellPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to PowerShell 7 (pwsh). Leave empty to auto-detect pwsh, then Windows PowerShell. User/machine setting only: a repository's workspace settings cannot change which executable runs."
        },
        "bcAlm.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show diagnostics for agent, skill, prompt and instruction files based on current GitHub Copilot / VS Code guidance."
        },
        "bcAlm.whatsNew.feedUrl": {
          "type": "string",
          "default": "https://github.blog/changelog/label/copilot/feed/",
          "description": "RSS feed used for the 'Copilot updates' section of the Guidance view."
        },
        "bcAlm.whatsNew.keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "agent",
            "skill",
            "prompt",
            "instruction",
            "MCP",
            "customiz",
            "VS Code",
            "coding agent",
            "model"
          ],
          "description": "Only changelog entries whose title contains one of these keywords (case-insensitive) are shown. Empty = show all."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "validate:catalog": "node out/src/cli/validate.js --root .. --base origin/main",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^1.2.0",
    "typescript": "^5.6.3"
  }
}
