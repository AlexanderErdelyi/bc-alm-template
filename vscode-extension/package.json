      },
      {
        "command": "bcAlm.groupByKind",
        "title": "Group Components by Kind",
        "category": "BC ALM",
        "icon": "$(list-flat)"
      },
      {
        "command": "bcAlm.manageComponents",
        "title": "Choose Components…",
        "category": "BC ALM",
        "icon": "$(checklist)"
      },
      {
        "command": "bcAlm.createNewTemplate",
        "title": "Create New Template…",
        "category": "BC ALM",
        "icon": "$(new-folder)"
      },
      {
        "command": "bcAlm.changeSourceRef",
        "title": "Change Version / Branch…",
        "category": "BC ALM",
        "icon": "$(versions)"
      },
      {
        "command": "bcAlm.openSourceOnGitHub",
