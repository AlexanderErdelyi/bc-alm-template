        "category": "BC ALM",
        "icon": "$(link-external)"
      },
      {
        "command": "bcAlm.shareTemplateSources",
        "title": "Share Template Sources with My Team…",
        "category": "BC ALM",
        "icon": "$(live-share)"
      },
      {
        "command": "bcAlm.addProjectSourcesToSettings",
        "title": "Add This Project's Sources to My Settings",
        "category": "BC ALM",
        "icon": "$(add)"
      },
      {
        "command": "bcAlm.validate",
        "title": "Validate Copilot Customizations",
        "category": "BC ALM",
        "icon": "$(checklist)"
      },
      {
        "command": "bcAlm.reviewWithCopilot",
        "title": "Review This Customization with Copilot",
        "category": "BC ALM",
        "icon": "$(copilot)"
      },
      {
        "command": "bcAlm.openBestPractices",
        "title": "Open Best-Practices Guide",
        "category": "BC ALM",
        "icon": "$(book)"
      },
      {
        "command": "bcAlm.refreshGuidance",
        "title": "Refresh What's New",
        "category": "BC ALM",
        "icon": "$(refresh)"
      },
      {
        "command": "bcAlm.openUrl",
        "title": "Open Link",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.adoptBaseline",
        "title": "Record Template Baseline (create template.lock.json)",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.migrateLayout",
        "title": "Move BC ALM Files into .bc-alm/",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.openFile",
        "title": "Open Component File",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.openFinding",
        "title": "Open Finding",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.browseTemplates",
        "title": "Browse Templates…",
        "category": "BC ALM",
        "icon": "$(library)"
      },
      {
        "command": "bcAlm.createCatalogTemplate",
        "title": "Add New Template to This Repository…",
        "category": "BC ALM",
