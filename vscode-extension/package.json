{
  "name": "bc-alm",
  "displayName": "BC ALM — Business Central Copilot Template Manager",
  "description": "Create Business Central projects from the BC ALM template, keep agents/skills/prompts/instructions up to date without losing your own changes, enable or disable components, and publish your customizations to your own template or upstream.",
  "version": "0.4.5",
  "publisher": "AlexanderErdelyi",
  "license": "MIT",
  "icon": "media/icon.png",
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0B3D5C",
    "theme": "dark"
  },
  "homepage": "https://github.com/AlexanderErdelyi/bc-alm-template/tree/main/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/AlexanderErdelyi/bc-alm-template/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/AlexanderErdelyi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderErdelyi/bc-alm-template.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "BC ALM runs git, the GitHub CLI and the template's PowerShell scripts, and reads executable paths from settings, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "BC ALM needs the project on a local or remote file system to run git and PowerShell."
    }
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "keywords": [
    "business central",
    "dynamics 365",
    "d365",
    "bc",
    "al",
    "copilot",
    "github copilot",
    "agents",
    "custom agents",
    "skills",
    "prompts",
    "instructions",
    "alm",
    "template",
    "spec-driven development"
  ],
  "activationEvents": [
    "workspaceContains:template.config.json",
    "workspaceContains:**/.github/agents/*.agent.md",
    "workspaceContains:**/.github/skills/*/SKILL.md"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bcAlm",
          "title": "BC ALM",
          "icon": "media/bc-alm.svg"
        }
      ]
    },
    "views": {
      "bcAlm": [
        {
          "id": "bcAlm.components",
          "name": "Components"
        },
        {
          "id": "bcAlm.sources",
          "name": "Template Sources"
        },
        {
          "id": "bcAlm.guidance",
          "name": "Guidance & What's New"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bcAlm.components",
        "contents": "No BC ALM project found in this workspace (no template.config.json).\n[Create New Project from Template](command:bcAlm.newProject)\n[Add BC ALM to This Repository](command:bcAlm.addToExistingRepo)\nLearn more in the [extension guide](https://github.com/AlexanderErdelyi/bc-alm-template/blob/main/docs/vscode-extension.md).",
        "when": "!bcAlm.hasProject"
      },
      {
        "view": "bcAlm.sources",
        "contents": "No template sources yet.\n[Add the BC ALM Template](command:bcAlm.addTemplateSource)\n[Create New Template](command:bcAlm.createNewTemplate)\nA template source is a git repository with Copilot agents, skills, prompts and instructions. Use several at once - e.g. BC ALM plus your team's BC Upgrade template."
      }
    ],
    "commands": [
      {
        "command": "bcAlm.newProject",
        "title": "New Project from Template…",
        "category": "BC ALM",
        "icon": "$(new-folder)"
      },
      {
        "command": "bcAlm.addToExistingRepo",
        "title": "Add BC ALM to This Repository…",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.refresh",
        "title": "Check for Template Updates",
        "category": "BC ALM",
        "icon": "$(refresh)"
      },
      {
        "command": "bcAlm.updateAll",
        "title": "Apply All Safe Updates",
        "category": "BC ALM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bcAlm.updateComponent",
        "title": "Update from Template",
        "category": "BC ALM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bcAlm.mergeComponent",
        "title": "Merge Template Changes (3-way)",
        "category": "BC ALM",
        "icon": "$(git-merge)"
      },
      {
        "command": "bcAlm.resetComponent",
        "title": "Reset to Template Version (discard my changes)",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.skipUpdate",
        "title": "Skip This Update (keep mine)",
        "category": "BC ALM"
      },
      {
        "command": "bcAlm.showDiff",
        "title": "Compare with Template",
        "category": "BC ALM",
        "icon": "$(diff)"
      },
      {
        "command": "bcAlm.keepLocal",
        "title": "Always Keep My Version (exclude from sync)",
        "category": "BC ALM",
        "icon": "$(pinned)"
      },
      {
        "command": "bcAlm.unkeepLocal",
        "title": "Resume Template Sync for This Component",
        "category": "BC ALM",
        "icon": "$(pin)"
      },
      {
        "command": "bcAlm.disableComponent",
        "title": "Disable Component",
        "category": "BC ALM",
        "icon": "$(circle-slash)"
      },
      {
        "command": "bcAlm.enableComponent",
        "title": "Enable Component",
        "category": "BC ALM",
        "icon": "$(check)"
      },
      {
        "command": "bcAlm.installComponent",
